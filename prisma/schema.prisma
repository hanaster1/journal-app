generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model JOURNAL_MAIN {
  id            Int     @id
  journal_title String
  publisher     String?

  abdc    ABDC_DB?
  ajg     AJG_DB?
  scimago SCIMAGO_DB?
  scopus  SCOPUS_DB?
  note    NOTE_DB?

  journalAreaDetails       JOURNAL_AREA_DETAIL[]
  journalAreaGroupDetails  JOURNAL_AREA_GROUP_DETAIL[]
  journalMajorGroupDetails JOURNAL_MAJOR_GROUP_DETAIL[]
}

model ABDC_DB {
  id             Int    @id
  issn_print     String?
  issn_online    String?
  year_inception Int?
  for_code       Int?
  abdc_area      String?
  rating_2025    String?
  notes          String?

  journal JOURNAL_MAIN @relation(fields: [id], references: [id])
}

model AJG_DB {
  id               Int     @id
  ajg_match_key    String?
  ajg_issn         String?
  ajg_title        String?
  ajg_subject_area String?
  ajg_2024_rating  String?

  journal JOURNAL_MAIN @relation(fields: [id], references: [id])
}

model SCIMAGO_DB {
  id                  Int     @id
  scimago_issn        String?
  scimago_eissn       String?
  scimago_title       String?
  sjr_best_quartile   String?
  scimago_categories  String?
  scimago_match_key   String?
  scimago_areas       String?

  journal JOURNAL_MAIN @relation(fields: [id], references: [id])
}

model SCOPUS_DB {
  id                          Int     @id
  scopus_match_key            String?
  scopus_issn                 String?
  scopus_eissn                String?
  scopus_title                String?
  active_status               String?
  coverage_years              String?
  discontinued                String?
  source_type                 String?
  top_level_life_sciences     String?
  top_level_social_sciences   String?
  top_level_physical_sciences String?
  top_level_health_sciences   String?
  asjc_1000_general           String?
  asjc_1100_agricultural_and_biological_sciences String?
  asjc_1200_arts_and_humanities String?
  asjc_1300_biochemistry_genetics_molecular_biology String?
  asjc_1400_business_management_accounting String?
  asjc_1500_chemical_engineering String?
  asjc_1600_chemistry          String?
  asjc_1700_computer_science   String?
  asjc_1800_decision_sciences  String?
  asjc_1900_earth_and_planetary_sciences String?
  asjc_2000_economics_econometrics_finance String?
  asjc_2100_energy             String?
  asjc_2200_engineering        String?
  asjc_2300_environmental_science String?
  asjc_2400_immunology_and_microbiology String?
  asjc_2500_materials_science  String?
  asjc_2600_mathematics        String?
  asjc_2700_medicine           String?
  asjc_2800_neuroscience       String?
  asjc_2900_nursing            String?
  asjc_3000_pharmacology_toxicology_pharmaceutics String?
  asjc_3100_physics_and_astronomy String?
  asjc_3200_psychology         String?
  asjc_3300_social_sciences    String?
  asjc_3400_veterinary         String?
  asjc_3500_dentistry          String?
  asjc_3600_health_professions String?

  journal JOURNAL_MAIN @relation(fields: [id], references: [id])
}

model NOTE_DB {
  id                Int     @id
  note_primary      String?
  note_secondary_1  String?
  note_secondary_2  String?
  note_secondary_3  String?
  adjustment_reason String?

  journal JOURNAL_MAIN @relation(fields: [id], references: [id])
}

model journal_area {
  id             Int      @id @default(autoincrement())
  journal_title  String
  issn_print     String?
  issn_online    String?
  source         String
  area           String?
  rank           String?
  active_status  String?
  source_type    String?
  best_rank      String?
  area_group     String?
  major_group    String
}

model AREA {
  area_id   Int     @id @default(autoincrement())
  area_name String  @unique

  journalAreaDetails JOURNAL_AREA_DETAIL[]
}

model JOURNAL_AREA_DETAIL {
  journal_id Int
  area_id    Int

  journal JOURNAL_MAIN @relation(fields: [journal_id], references: [id])
  area    AREA         @relation(fields: [area_id], references: [area_id])

  @@id([journal_id, area_id])
}

model AREA_GROUP {
  area_group_id   Int     @id @default(autoincrement())
  area_group_name String  @unique

  journalAreaGroupDetails JOURNAL_AREA_GROUP_DETAIL[]
}

model JOURNAL_AREA_GROUP_DETAIL {
  journal_id      Int
  area_group_id   Int

  journal     JOURNAL_MAIN @relation(fields: [journal_id], references: [id])
  areaGroup   AREA_GROUP   @relation(fields: [area_group_id], references: [area_group_id])

  @@id([journal_id, area_group_id])
}

model MAJOR_GROUP {
  major_group_id   Int     @id @default(autoincrement())
  major_group_name String  @unique

  journalMajorGroupDetails JOURNAL_MAJOR_GROUP_DETAIL[]
}

model JOURNAL_MAJOR_GROUP_DETAIL {
  journal_id      Int
  major_group_id  Int

  journal     JOURNAL_MAIN @relation(fields: [journal_id], references: [id])
  majorGroup  MAJOR_GROUP  @relation(fields: [major_group_id], references: [major_group_id])

  @@id([journal_id, major_group_id])
}
